<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card"
    android:padding="18dp"
    android:layout_marginBottom="12dp">

    <!-- Product Name -->
    <TextView
        android:id="@+id/tvItemProductName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="USB Cable"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#0F172A" />

    <!-- Product Category -->
    <TextView
        android:id="@+id/tvItemCategory"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Electronics"
        android:textSize="14sp"
        android:textColor="#64748B"
        android:layout_marginTop="5dp" />

    <!-- Stock Status -->
    <TextView
        android:id="@+id/tvItemStockStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="IN STOCK"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="#16A34A"
        android:layout_marginTop="12dp" />

    <!-- Price -->
    <TextView
        android:id="@+id/tvItemPrice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Unit Price: Rs. 850.00"
        android:textSize="15sp"
        android:textColor="#334155"
        android:layout_marginTop="12dp" />

    <!-- Quantity -->
    <TextView
        android:id="@+id/tvItemQuantity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Quantity: 10 units"
        android:textSize="15sp"
        android:textColor="#334155"
        android:layout_marginTop="6dp" />

    <!-- Total Stock Value -->
    <TextView
        android:id="@+id/tvItemStockValue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Stock Value: Rs. 8,500.00"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#1D4ED8"
        android:layout_marginTop="12dp" />

    <!-- Edit and Delete Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="18dp">

        <Button
            android:id="@+id/btnItemEdit"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Edit"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:backgroundTint="#2563EB"
            android:layout_marginEnd="6dp" />

        <Button
            android:id="@+id/btnItemDelete"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Delete"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:backgroundTint="#DC2626"
            android:layout_marginStart="6dp" />

    </LinearLayout>

</LinearLayout>