<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FB"
    android:fitsSystemWindows="true"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Page Title -->
        <TextView
            android:id="@+id/tvFormTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Add New Product"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#1D4ED8" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Enter product information below"
            android:textSize="15sp"
            android:textColor="#64748B"
            android:layout_marginTop="6dp" />

        <!-- Form Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="20dp"
            android:layout_marginTop="25dp">

            <!-- Product Name -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Product Name"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#1E293B" />

            <EditText
                android:id="@+id/etProductName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="54dp"
                android:hint="e.g. USB Cable"
                android:inputType="textCapWords"
                android:singleLine="true"
                android:padding="14dp"
                android:textColor="#0F172A"
                android:textColorHint="#94A3B8"
                android:background="@drawable/bg_input"
                android:layout_marginTop="8dp" />

            <!-- Category -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Category"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#1E293B"
                android:layout_marginTop="20dp" />

            <EditText
                android:id="@+id/etCategory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="54dp"
                android:hint="e.g. Electronics"
                android:inputType="textCapWords"
                android:singleLine="true"
                android:padding="14dp"
                android:textColor="#0F172A"
                android:textColorHint="#94A3B8"
                android:background="@drawable/bg_input"
                android:layout_marginTop="8dp" />

            <!-- Price -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Unit Price (Rs.)"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#1E293B"
                android:layout_marginTop="20dp" />

            <EditText
                android:id="@+id/etPrice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="54dp"
                android:hint="e.g. 850.00"
                android:inputType="numberDecimal"
                android:singleLine="true"
                android:padding="14dp"
                android:textColor="#0F172A"
                android:textColorHint="#94A3B8"
                android:background="@drawable/bg_input"
                android:layout_marginTop="8dp" />

            <!-- Quantity -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Stock Quantity"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#1E293B"
                android:layout_marginTop="20dp" />

            <EditText
                android:id="@+id/etQuantity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="54dp"
                android:hint="e.g. 10"
                android:inputType="number"
                android:singleLine="true"
                android:padding="14dp"
                android:textColor="#0F172A"
                android:textColorHint="#94A3B8"
                android:background="@drawable/bg_input"
                android:layout_marginTop="8dp" />

        </LinearLayout>

        <!-- Save Button -->
        <Button
            android:id="@+id/btnSaveProduct"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="Save Product"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:backgroundTint="#2563EB"
            android:layout_marginTop="25dp" />

        <!-- Cancel Button -->
        <Button
            android:id="@+id/btnCancel"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="Cancel"
            android:textSize="16sp"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:backgroundTint="#64748B"
            android:layout_marginTop="10dp" />

    </LinearLayout>

</ScrollView>